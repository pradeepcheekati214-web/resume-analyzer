# ── App ────────────────────────────────────────────────
APP_ENV=development
APP_NAME=Resume Analyzer API
APP_VERSION=1.0.0
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Security ───────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ───────────────────────────────────────────
DATABASE_URL=sqlite:///./resume_analyzer.db

# ── AWS ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=resume-analyzer-files-dev
S3_PRESIGNED_URL_EXPIRY=3600

# ── DynamoDB ───────────────────────────────────────────
DYNAMODB_TABLE_NAME=resume-analyzer-results
DYNAMODB_ENDPOINT_URL=

# ── Cognito ────────────────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1

# ── File Upload ────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.docx,.doc

# ── CloudWatch ─────────────────────────────────────────
CLOUDWATCH_LOG_GROUP=resume-analyzer
CLOUDWATCH_LOG_STREAM=api

# ── AI / LLM ───────────────────────────────────────────
# Provider: mock (no key needed) | openai | bedrock
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7
